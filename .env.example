# Environment Configuration Example
# Copy this file to .env and adjust variables as needed

SECRET_KEY=savyant-super-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration:
# Choose 'sqlite' (default for quick run) or 'mysql'
DB_ENGINE=sqlite

# MySQL Configuration (used when DB_ENGINE=mysql)
DB_NAME=savyant_sales_db
DB_USER=root
DB_PASSWORD=rootpassword
DB_HOST=127.0.0.1
DB_PORT=3306
